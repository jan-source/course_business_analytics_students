{
  "name": "Dark Navy Theme",
  "dataColors": [
    "#16283D",    
    "#3B5F8E",    
    "#5983BF",
    "#6A95D8",
    "#7D4F73",
    "#FFD700",
    "#228B22",
    "#DC143C"
  
  ],
  "background": "#FFFFFF",
  "foreground": "#16283D",
  "tableAccent": "#16283D",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontSize": 16,
            "fontFamily": "Calibri",
            "color": "#16283D"
          }
        ],
        "labels": [
          {
            "color": "#16283D"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "values": [
          {
            "fontFamily": "Calibri",
            "fontSize": 12,
            "color": "#16283D"
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Calibri",
            "fontSize": 14,
            "color": "#16283D",
            "fontBold": true
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "values": [
          {
            "fontFamily": "Calibri",
            "fontSize": 12,
            "color": "#16283D"
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Calibri",
            "fontSize": 14,
            "color": "#16283D",
            "fontBold": true
          }
        ]
      }
    }
  }
}
